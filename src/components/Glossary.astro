---
// Renders the whole glossary from src/data/glossary.mjs, grouped by first letter.
import { glossary } from '../data/glossary.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const isExternal = (href: string) => /^[a-z]+:\/\//i.test(href);
const readMoreHref = (href: string) => (isExternal(href) ? href : `${base}${href}`);

const sorted = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const groups = new Map<string, typeof glossary>();
for (const entry of sorted) {
	const letter = entry.term[0].toUpperCase();
	if (!groups.has(letter)) groups.set(letter, []);
	groups.get(letter)!.push(entry);
}
---

<p class="glossary-letters">
	{[...groups.keys()].map((letter) => <a href={`#letter-${letter}`}>{letter}</a>)}
</p>

{
	[...groups].map(([letter, entries]) => (
		<section>
			<h2 id={`letter-${letter}`}>{letter}</h2>
			<dl class="glossary-list">
				{entries.map((entry) => (
					<>
						<dt id={entry.id}>
							{entry.term}
							{entry.expansion && <span class="glossary-expansion"> ({entry.expansion})</span>}
						</dt>
						<dd>
							<p>
								{entry.short} {entry.explanation}
							</p>
							{entry.readMore && (
								<p>
									Read more:{' '}
									<a href={readMoreHref(entry.readMore.href)}>{entry.readMore.label}</a>
								</p>
							)}
						</dd>
					</>
				))}
			</dl>
		</section>
	))
}

<style>
	.glossary-letters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		font-weight: 600;
	}
</style>

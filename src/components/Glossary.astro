---
// Renders the whole glossary from src/data/glossary.mjs in alphabetical order.
// The "On this page" list for this page is built in src/routeData.ts.
import { glossary } from '../data/glossary.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const isExternal = (href: string) => /^[a-z]+:\/\//i.test(href);
const readMoreHref = (href: string) => (isExternal(href) ? href : `${base}${href}`);

const sorted = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
---

<dl class="glossary-list">
	{
		sorted.map((entry) => (
			<>
				<dt id={entry.id}>
					{entry.term}
					{entry.expansion && <span class="glossary-expansion"> ({entry.expansion})</span>}
				</dt>
				<dd>
					<p>
						{entry.short} {entry.explanation}
					</p>
					{entry.readMore && (
						<p>
							Read more: <a href={readMoreHref(entry.readMore.href)}>{entry.readMore.label}</a>
						</p>
					)}
				</dd>
			</>
		))
	}
</dl>
